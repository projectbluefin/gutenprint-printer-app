{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "local>projectbluefin/renovate-config"
  ],
  "forkProcessing": "enabled",
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^include\\/source-pins\\.yml$/"
      ],
      "matchStrings": [
        "gutenprint-version: \"[^\"]+\"\\n  gutenprint-tag: \"debian/(?<currentValue>[^\"]+)\"\\n  gutenprint-ref: \"(?<currentDigest>[0-9a-f]{40})\""
      ],
      "packageNameTemplate": "https://salsa.debian.org/printing-team/gutenprint.git",
      "depNameTemplate": "Gutenprint CUPS driver",
      "datasourceTemplate": "git-tags",
      "extractVersionTemplate": "^debian/(?<version>.+)$",
      "versioningTemplate": "deb",
      "autoReplaceStringTemplate": "gutenprint-version: \"{{{replace '^(\\d+\\.\\d+\\.\\d+)(?:[.-].*)?-(\\d+)$' '$1-$2' newValue}}}\"\n  gutenprint-tag: \"debian/{{{newValue}}}\"\n  gutenprint-ref: \"{{{newDigest}}}\"",
      "description": "Update the tag, dereferenced commit, and packaged version together."
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^elements\\/fsdk-containers\\.bst$/"
      ],
      "matchStrings": [
        "track: (?<currentValue>main)\\n  ref: (?:\\S+-g)?(?<currentDigest>[0-9a-f]{40})"
      ],
      "depNameTemplate": "https://github.com/projectbluefin/fsdk-containers",
      "datasourceTemplate": "git-refs",
      "autoReplaceStringTemplate": "track: {{{newValue}}}\n  ref: {{{newDigest}}}",
      "description": "Track the fsdk-containers junction (FSDK and the shared printing base) at main."
    }
  ],
  "packageRules": [
    {
      "matchDatasources": [
        "git-tags"
      ],
      "matchPackageNames": [
        "https://salsa.debian.org/printing-team/gutenprint.git"
      ],
      "allowedVersions": "/^5\\.3\\./",
      "automerge": false
    },
    {
      "description": "fsdk-containers bumps merge themselves once the required native image checks pass; revert the PR to roll back.",
      "matchDepNames": [
        "https://github.com/projectbluefin/fsdk-containers"
      ],
      "automerge": true,
      "automergeType": "pr",
      "platformAutomerge": true,
      "ignoreTests": false,
      "minimumReleaseAge": null
    },
    {
      "description": "BuildStream builds fail on ubuntu-26.04 runners (fsdk-containers#332); keep 24.04",
      "matchDatasources": [
        "github-runners"
      ],
      "matchPackageNames": [
        "ubuntu"
      ],
      "allowedVersions": "/^24\\.04(?:-arm)?$/"
    },
    {
      "description": "Third-party GitHub Actions updates wait three days after release, then Renovate automerges them. The hive also merges Renovate PRs once the required checks pass, because mergeraptor is a trusted bot.",
      "matchManagers": ["github-actions"],
      "matchPackageNames": ["!projectbluefin/**"],
      "matchUpdateTypes": ["minor", "patch", "digest", "pin", "pinDigest"],
      "groupName": "github-actions-third-party-non-major",
      "pinDigests": true,
      "minimumReleaseAge": "3 days",
      "automerge": true
    },
    {
      "description": "First-party projectbluefin/** actions merge right away and open at any time.",
      "matchManagers": ["github-actions"],
      "matchPackageNames": ["projectbluefin/**"],
      "matchUpdateTypes": ["minor", "patch", "digest", "pin", "pinDigest"],
      "groupName": "github-actions-first-party-non-major",
      "pinDigests": true,
      "schedule": ["at any time"],
      "automerge": true
    },
    {
      "description": "registry-actions.yml is a human-merge path in the hive. Give its updates their own branches, so a pin-only update to it is a PR of its own that the hive's pin-only exception can merge, instead of being held with other workflows.",
      "matchFileNames": [".github/workflows/registry-actions.yml"],
      "additionalBranchPrefix": "publishing-workflows-"
    },
    {
      "description": "Renovate never automerges GitHub Actions majors. The hive's trusted-bot merge policy is independent of this setting.",
      "matchManagers": ["github-actions"],
      "matchUpdateTypes": ["major"],
      "automerge": false
    }
  ]
}
