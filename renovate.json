{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "local>projectbluefin/renovate-config"
  ],
  "forkProcessing": "enabled",
  "baseBranchPatterns": [
    "testing"
  ],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^include\\/source-pins\\.yml$/"
      ],
      "matchStrings": [
        "gutenprint-version: \"[^\"]+\"\\n  gutenprint-tag: \"debian/(?<currentValue>[^\"]+)\"\\n  gutenprint-ref: \"(?<currentDigest>[0-9a-f]{40})\""
      ],
      "packageNameTemplate": "https://salsa.debian.org/printing-team/gutenprint.git",
      "depNameTemplate": "Gutenprint CUPS driver",
      "datasourceTemplate": "git-tags",
      "extractVersionTemplate": "^debian/(?<version>.+)$",
      "versioningTemplate": "deb",
      "autoReplaceStringTemplate": "gutenprint-version: \"{{{replace '^(\\d+\\.\\d+\\.\\d+)(?:[.-].*)?-(\\d+)$' '$1-$2' newValue}}}\"\n  gutenprint-tag: \"debian/{{{newValue}}}\"\n  gutenprint-ref: \"{{{newDigest}}}\"",
      "description": "Update the tag, dereferenced commit, and packaged version together."
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^elements\\/fsdk-containers\\.bst$/"
      ],
      "matchStrings": [
        "track: (?<currentValue>main)\\n  ref: (?:\\S+-g)?(?<currentDigest>[0-9a-f]{40})"
      ],
      "depNameTemplate": "https://github.com/projectbluefin/fsdk-containers",
      "datasourceTemplate": "git-refs",
      "autoReplaceStringTemplate": "track: {{{newValue}}}\n  ref: {{{newDigest}}}",
      "description": "Track the fsdk-containers junction (FSDK and the shared printing base) at main."
    }
  ],
  "packageRules": [
    {
      "matchDatasources": [
        "git-tags"
      ],
      "matchPackageNames": [
        "https://salsa.debian.org/printing-team/gutenprint.git"
      ],
      "allowedVersions": "/^5\\.3\\./",
      "automerge": false
    },
    {
      "description": "fsdk-containers bumps merge themselves once the required native image checks pass; revert the PR to roll back.",
      "matchDepNames": [
        "https://github.com/projectbluefin/fsdk-containers"
      ],
      "automerge": true,
      "automergeType": "pr",
      "platformAutomerge": true,
      "ignoreTests": false,
      "minimumReleaseAge": null
    },
    {
      "description": "BuildStream builds fail on ubuntu-26.04 runners (fsdk-containers#332); keep 24.04",
      "matchDatasources": [
        "github-runners"
      ],
      "matchPackageNames": [
        "ubuntu"
      ],
      "allowedVersions": "/^24\\.04(?:-arm)?$/"
    }
  ]
}
