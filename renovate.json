{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "local>projectbluefin/renovate-config"
  ],
  "forkProcessing": "enabled",
  "baseBranchPatterns": [
    "testing"
  ],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^include\\/source-pins\\.yml$/"
      ],
      "matchStrings": [
        "gutenprint-version: \"[^\"]+\"\\n  gutenprint-tag: \"(?<currentValue>debian/[^\"]+)\"\\n  gutenprint-ref: \"(?<currentDigest>[0-9a-f]{40})\""
      ],
      "packageNameTemplate": "https://salsa.debian.org/printing-team/gutenprint.git",
      "depNameTemplate": "Gutenprint CUPS driver",
      "datasourceTemplate": "git-tags",
      "versioningTemplate": "regex:^debian/(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)-.*-(?<build>\\d+)$",
      "autoReplaceStringTemplate": "gutenprint-version: \"{{{replace '^debian/(\\d+\\.\\d+\\.\\d+)-.*-(\\d+)$' '$1-$2' newValue}}}\"\n  gutenprint-tag: \"{{{newValue}}}\"\n  gutenprint-ref: \"{{{newDigest}}}\"",
      "description": "Update the tag, dereferenced commit, and packaged version together."
    }
  ],
  "packageRules": [
    {
      "matchDatasources": [
        "git-tags"
      ],
      "matchPackageNames": [
        "https://salsa.debian.org/printing-team/gutenprint.git"
      ],
      "allowedVersions": "/^debian\\/5\\.3\\.\\d+-.*-\\d+$/",
      "automerge": false
    },
    {
      "description": "BuildStream builds fail on ubuntu-26.04 runners (fsdk-containers#332); keep 24.04",
      "matchDatasources": [
        "github-runners"
      ],
      "matchPackageNames": [
        "ubuntu"
      ],
      "allowedVersions": "<26"
    }
  ]
}
